rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function activeStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function productManager() {
      return activeStaff()
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role in ['owner', 'supervisor'];
    }

    match /product-images/{fileName} {
      allow read: if true;
      allow create: if productManager()
        && resource == null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.sku is string
        && request.resource.metadata.sku.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$')
        && (
          fileName == request.resource.metadata.sku + '.jpg'
          || fileName == request.resource.metadata.sku + '.jpeg'
          || fileName == request.resource.metadata.sku + '.png'
          || fileName == request.resource.metadata.sku + '.webp'
        );
      allow update, delete: if false;
    }

    // Bukti pembayaran QRIS dari pelanggan: hanya pemilik yang boleh mengunggah, staf yang boleh melihat.
    match /proofs/{uid}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if activeStaff() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if false;
    }

    // Foto produk di root bucket dibaca publik oleh website; tulis hanya lewat Firebase Console.
    match /{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
